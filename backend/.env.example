# Servidor
PORT=4000
JWT_SECRET=cambia_este_valor_por_uno_seguro

# PostgreSQL
# En produccion (Supabase) define DATABASE_URL y se ignoran las variables PG*
# DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres
PGHOST=localhost
PGPORT=5432
PGDATABASE=reservar
PGUSER=postgres
PGPASSWORD=postgres

# Admin inicial (se crea al ejecutar npm run seed)
ADMIN_EMAIL=admin@reservar.com
ADMIN_PASSWORD=cambia_esta_contrasena

# Cantidad de cabinas por defecto al inicializar la base de datos
DEFAULT_CABINS=28

# Correo (SMTP) para el resumen diario de reservas
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tu_correo@gmail.com
SMTP_PASSWORD=tu_contrasena_de_aplicacion
MAIL_FROM="Reservas Cabinas <tu_correo@gmail.com>"
MAIL_TO=admin@reservar.com

# Hora del envio diario (formato cron), por defecto 7:00am todos los dias
DAILY_EMAIL_CRON=0 7 * * *
TIMEZONE=America/Costa_Rica

# Secreto que Vercel Cron envia al endpoint /api/cron/daily-summary (solo produccion)
CRON_SECRET=genera_un_valor_aleatorio_largo
